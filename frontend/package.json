{
  "name": "jpetstore-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JPetStore modern frontend (Vue 3 + TypeScript). Secrets are never exposed through VITE_ prefixed variables.",
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "e2e": "playwright test",
    "openapi:types": "openapi-typescript ../docs/contracts/openapi.yaml -o src/shared/api/schema.d.ts",
    "openapi:lint": "redocly lint ../docs/contracts/openapi.yaml"
  },
  "dependencies": {
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "yaml": "2.8.1"
  }
}
