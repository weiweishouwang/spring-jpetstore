# 依赖中间件的本机注册表示例。
#
# 复制成 scripts/deps.local.conf（该文件不入库）后按本机情况改：
#
#   cp scripts/deps.local.conf.example scripts/deps.local.conf
#
# 三个脚本（deps-start.sh / deps-stop.sh / deps-status.sh）会优先读这个文件；
# 文件里定义了 deps_register_services() 就完全接管注册表，不定义就用仓库默认的
# MySQL 8.4（docker compose）。
#
# deps_add_service 的八个参数：
#
#   1 id         服务标识，用于 --service 选择与 PID 文件名
#   2 label      展示名
#   3 manager    docker | brew | systemd | jar | command
#   4 start      启动命令
#   5 stop       停止命令
#   6 status     状态命令：退出码 0 表示正在运行，非 0 表示没在跑
#   7 probe      就绪探针：port:主机:端口 | http:URL | cmd:命令 | none
#   8 ports      要展示的端口列表（逗号分隔）
#
# jar / command 两种方式由脚本自己后台运行并记录 PID（第 4 个参数给启动命令，
# 第 5、6 个参数写 true 占位）；brew / systemd / docker 走各自的管理器。
#
# 这里不要写口令：需要凭据的服务用环境变量或配置文件，脚本不打印也不落盘。

deps_register_services() {
  # 例子一：Homebrew 托管的 MySQL。
  # deps_add_service \
  #     "mysql" \
  #     "MySQL 8.4" \
  #     "brew" \
  #     "brew services start mysql@8.4" \
  #     "brew services stop mysql@8.4" \
  #     "brew services info mysql@8.4 | grep -q 'Running: yes'" \
  #     "port:127.0.0.1:3306" \
  #     "3306"

  # 例子二：systemd 托管的 Redis。
  # deps_add_service \
  #     "redis" \
  #     "Redis 7" \
  #     "systemd" \
  #     "systemctl start redis-server" \
  #     "systemctl stop redis-server" \
  #     "systemctl is-active --quiet redis-server" \
  #     "port:127.0.0.1:6379" \
  #     "6379"

  # 例子三：手动跑的 jar（脚本负责后台运行、记录 PID 与日志）。
  # deps_add_service \
  #     "search" \
  #     "搜索服务" \
  #     "jar" \
  #     "java -jar /opt/search/search.jar --port 9200" \
  #     "true" \
  #     "true" \
  #     "http:http://127.0.0.1:9200/health" \
  #     "9200"

  # 例子四：任意命令，用端口判断就绪。
  # deps_add_service \
  #     "queue" \
  #     "消息队列" \
  #     "command" \
  #     "/opt/queue/bin/start.sh" \
  #     "true" \
  #     "true" \
  #     "port:127.0.0.1:5672" \
  #     "5672"

  # 本机真正要管的服务写在这里（把上面的例子按需启用）。
  deps_add_service \
      "mysql" \
      "MySQL 8.4" \
      "docker" \
      "docker compose --env-file .env.dev -f infra/compose.dev.yml up -d --wait mysql" \
      "docker compose --env-file .env.dev -f infra/compose.dev.yml stop mysql" \
      "docker compose --env-file .env.dev -f infra/compose.dev.yml ps --status running --services mysql | grep -qx mysql" \
      "port:127.0.0.1:3306" \
      "3306"
}
