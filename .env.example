# Copy to an ignored .env.dev and set local-only values. Do not commit .env.dev.
# Docker Compose reads this only with --env-file; Boot does not load .env automatically.
MYSQL_DATABASE=jpetstore_dev
MYSQL_USER=jpetstore_app
MYSQL_PASSWORD=REPLACE_WITH_LOCAL_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_ROOT_PASSWORD
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=5173
# Export these when launching Boot on the host; never prefix secrets with VITE_.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/jpetstore_dev?connectionTimeZone=UTC
SPRING_DATASOURCE_USERNAME=jpetstore_app
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_LOCAL_APP_PASSWORD
SPRING_PROFILES_ACTIVE=dev
